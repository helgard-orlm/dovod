// Dovod Player — a video player for Windows.
// Build:  dovod build examples/player.dv --target win64     (or win32 for 32-bit Windows)
// Use:    player.exe [FILES...]   or drag files into the window, or press O.
//
// Playback itself is done by Windows (Media Foundation) through the `video` effect.
// Everything the player DECIDES — keys, playlist, seeking, volume, the status line — is pure,
// exampled code below; `main` only carries events in and commands out.

record Player {
  files: List[Text]
  idx: Int          // which file is open; -1 = none
  paused: Bool
  ended: Bool       // the current file played to its end
  vol: Int          // 0..100
  muted: Bool
  full: Bool
  rate: Int         // speed in percent, 25..400
  note: Text        // a message in the status line…
  note_until: Int   // …shown until this clock time (ms)
  quit: Bool
}

enum Cmd {
  Open(path: Text)
  Title(text: Text)
  Pick
  Pause(on: Bool)
  Seek(ms: Int)
  Volume(pct: Int)
  Mute(on: Bool)
  Rate(pct: Int)
  Full(on: Bool)
}

record Step { p: Player, cmds: List[Cmd] }

enum Ev {
  Tick
  Key(name: Text)
  Click
  DblClick
  Wheel(up: Bool)
  Drop(paths: List[Text])
  Loaded
  Ended
  Closed
  Failed(msg: Text)
}

const seek_small: Int = 5000
const seek_big: Int = 60000
const vol_step: Int = 5
const note_ms: Int = 4000
const help: Text = "Пробел пауза · ←→ 5 с, Shift 1 мин · 0–9 доля · ↑↓ громкость · M звук · [ ] скорость · F экран · N/P файлы · O открыть · Q выход"

// ---------------------------------------------------------------- small pieces

fn clamp(x: Int, lo: Int, hi: Int) -> Int
  need lo <= hi
  give out >= lo and out <= hi
  ex clamp(5, 0, 10) == 5
  ex clamp(-3, 0, 10) == 0
  ex clamp(42, 0, 10) == 10
{
  return max(lo, min(hi, x))
}

fn pad2(n: Int) -> Text
  need n >= 0
  ex pad2(7) == "07"
  ex pad2(42) == "42"
{
  if n < 10 {
    return "0" + show(n)
  }
  return show(n)
}

fn fmt_time(ms: Int) -> Text
  ex fmt_time(0) == "0:00"
  ex fmt_time(65999) == "1:05"
  ex fmt_time(3723000) == "1:02:03"
  ex fmt_time(-5) == "0:00"
{
  let s = max(ms, 0) / 1000
  let h = s / 3600
  let m = s % 3600 / 60
  if h > 0 {
    return show(h) + ":" + pad2(m) + ":" + pad2(s % 60)
  }
  return show(m) + ":" + pad2(s % 60)
}

fn rate_text(pct: Int) -> Text
  need pct > 0
  ex rate_text(100) == "1"
  ex rate_text(150) == "1.5"
  ex rate_text(125) == "1.25"
  ex rate_text(25) == "0.25"
{
  let whole = show(pct / 100)
  let frac = pct % 100
  if frac == 0 {
    return whole
  }
  if frac % 10 == 0 {
    return whole + "." + show(frac / 10)
  }
  return whole + "." + pad2(frac)
}

fn base_name(path: Text) -> Text
  ex base_name("C:\\Video\\кино.mp4") == "кино.mp4"
  ex base_name("/home/a/b.mkv") == "b.mkv"
  ex base_name("clip.avi") == "clip.avi"
{
  var from = 0
  for i in 0..len(path) {
    let b = byte(path, i)
    if b == 92 or b == 47 {
      from = i + 1
    }
  }
  return slice(path, from, len(path))
}

// ---------------------------------------------------------------- events

fn parse_event(ev: Text) -> Ev
  ex parse_event("tick") == Tick
  ex parse_event("key:shift+LEFT") == Key(name: "shift+LEFT")
  ex parse_event("click") == Click
  ex parse_event("dblclick") == DblClick
  ex parse_event("wheel:up") == Wheel(up: true)
  ex parse_event("wheel:down") == Wheel(up: false)
  ex parse_event("drop:C:\\a.mp4\nC:\\b.mkv") == Drop(paths: ["C:\\a.mp4", "C:\\b.mkv"])
  ex parse_event("loaded") == Loaded
  ex parse_event("ended") == Ended
  ex parse_event("closed") == Closed
  ex parse_event("error:no decoder") == Failed(msg: "no decoder")
  ex parse_event("something new") == Tick
{
  if starts_with(ev, "key:") {
    return Key(name: slice(ev, 4, len(ev)))
  }
  if starts_with(ev, "drop:") {
    return Drop(paths: split(slice(ev, 5, len(ev)), "\n"))
  }
  if starts_with(ev, "error:") {
    return Failed(msg: slice(ev, 6, len(ev)))
  }
  if starts_with(ev, "wheel:") {
    return Wheel(up: ev == "wheel:up")
  }
  if ev == "click" {
    return Click
  }
  if ev == "dblclick" {
    return DblClick
  }
  if ev == "loaded" {
    return Loaded
  }
  if ev == "ended" {
    return Ended
  }
  if ev == "closed" {
    return Closed
  }
  return Tick   // unknown events are ignored: an older player keeps working with a newer runtime
}

// ---------------------------------------------------------------- the player

fn new_player(files: List[Text]) -> Player
  ex new_player(["a.mp4"]).files == ["a.mp4"]
  ex new_player([]).vol == 100
  ex new_player([]).idx == -1
{
  return Player(files: files, idx: -1, paused: false, ended: false, vol: 100, muted: false, full: false,
                rate: 100, note: "", note_until: 0, quit: false)
}

// test fixture: a player with two files, the first one playing
fn playing() -> Player
  ex playing().idx == 0
  ex len(playing().files) == 2
{
  var p = new_player(["C:\\v\\one.mp4", "C:\\v\\two.mkv"])
  p.idx = 0
  return p
}

fn with_note(p: Player, text: Text, now: Int) -> Player
  ex with_note(playing(), "hi", 1000).note == "hi"
  ex with_note(playing(), "hi", 1000).note_until == 5000
{
  var q = p
  q.note = text
  q.note_until = now + note_ms
  return q
}

fn open_at(p: Player, i: Int) -> Step
  need i >= 0 and i < len(p.files)
  ex open_at(playing(), 1).cmds == [Open(path: "C:\\v\\two.mkv"), Title(text: "two.mkv — Dovod Player")]
  ex open_at(playing(), 1).p.idx == 1
{
  var q = p
  q.idx = i
  q.paused = false
  q.ended = false
  return Step(p: q, cmds: [Open(path: p.files[i]), Title(text: base_name(p.files[i]) + " — Dovod Player")])
}

fn start(p: Player) -> Step
  ex start(new_player(["x.mp4"])).cmds == [Open(path: "x.mp4"), Title(text: "x.mp4 — Dovod Player")]
  ex start(new_player([])).cmds == [Pick]
{
  if len(p.files) == 0 {
    return Step(p: p, cmds: [Pick])
  }
  return open_at(p, 0)
}

fn seek_by(p: Player, delta: Int, pos: Int, dur: Int) -> Step
  ex seek_by(playing(), 5000, 10000, 60000).cmds == [Seek(ms: 15000)]
  ex seek_by(playing(), -5000, 3000, 60000).cmds == [Seek(ms: 0)]
  ex seek_by(playing(), 60000, 30000, 60000).cmds == [Seek(ms: 59000)]
  ex seek_by(playing(), 5000, 1000, 0).cmds == [Seek(ms: 6000)]
{
  var target = max(pos + delta, 0)
  if dur > 0 {
    target = min(target, max(dur - 1000, 0))
  }
  var q = p
  q.ended = false
  return Step(p: q, cmds: [Seek(ms: target)])
}

fn set_volume(p: Player, vol: Int, now: Int) -> Step
  ex set_volume(playing(), 120, 0).cmds == [Volume(pct: 100), Mute(on: false)]
  ex set_volume(playing(), 40, 0).p.note == "Громкость 40%"
{
  var q = with_note(p, "", now)
  q.vol = clamp(vol, 0, 100)
  q.muted = false
  q.note = "Громкость " + show(q.vol) + "%"
  return Step(p: q, cmds: [Volume(pct: q.vol), Mute(on: false)])
}

fn set_rate(p: Player, rate: Int, now: Int) -> Step
  ex set_rate(playing(), 125, 0).cmds == [Rate(pct: 125)]
  ex set_rate(playing(), 500, 0).p.rate == 400
  ex set_rate(playing(), 10, 0).p.note == "Скорость ×0.25"
{
  var q = p
  q.rate = clamp(rate, 25, 400)
  return Step(p: with_note(q, "Скорость ×" + rate_text(q.rate), now), cmds: [Rate(pct: q.rate)])
}

fn toggle_pause(p: Player) -> Step
  ex toggle_pause(playing()).cmds == [Pause(on: true)]
  ex toggle_pause(toggle_pause(playing()).p).cmds == [Pause(on: false)]
  ex toggle_pause(new_player([])).cmds == []
{
  let none_cmds: List[Cmd] = []
  if p.idx < 0 {
    return Step(p: p, cmds: none_cmds)
  }
  var q = p
  if p.ended {
    q.ended = false
    q.paused = false
    return Step(p: q, cmds: [Seek(ms: 0), Pause(on: false)])
  }
  q.paused = not p.paused
  return Step(p: q, cmds: [Pause(on: q.paused)])
}

fn set_full(p: Player, on: Bool) -> Step
  ex set_full(playing(), true).cmds == [Full(on: true)]
  ex set_full(playing(), true).p.full == true
{
  var q = p
  q.full = on
  return Step(p: q, cmds: [Full(on: on)])
}

fn go(p: Player, delta: Int, now: Int) -> Step
  ex go(playing(), 1, 0).p.idx == 1
  ex go(playing(), -1, 0).p.note == "Это первый файл"
  ex go(go(playing(), 1, 0).p, 1, 0).p.note == "Это последний файл"
  ex go(new_player([]), 1, 0).cmds == []
{
  let none_cmds: List[Cmd] = []
  if p.idx < 0 {
    return Step(p: p, cmds: none_cmds)
  }
  let i = p.idx + delta
  if i < 0 {
    return Step(p: with_note(p, "Это первый файл", now), cmds: none_cmds)
  }
  if i >= len(p.files) {
    return Step(p: with_note(p, "Это последний файл", now), cmds: none_cmds)
  }
  return open_at(p, i)
}

fn on_key(p: Player, key: Text, pos: Int, dur: Int, now: Int) -> Step
  ex on_key(playing(), "SPACE", 0, 0, 0).cmds == [Pause(on: true)]
  ex on_key(playing(), "RIGHT", 10000, 60000, 0).cmds == [Seek(ms: 15000)]
  ex on_key(playing(), "LEFT", 10000, 60000, 0).cmds == [Seek(ms: 5000)]
  ex on_key(playing(), "shift+RIGHT", 0, 600000, 0).cmds == [Seek(ms: 60000)]
  ex on_key(playing(), "shift+LEFT", 90000, 600000, 0).cmds == [Seek(ms: 30000)]
  ex on_key(playing(), "HOME", 90000, 600000, 0).cmds == [Seek(ms: 0)]
  ex on_key(playing(), "5", 0, 600000, 0).cmds == [Seek(ms: 300000)]
  ex on_key(playing(), "UP", 0, 0, 0).cmds == [Volume(pct: 100), Mute(on: false)]
  ex on_key(playing(), "DOWN", 0, 0, 0).cmds == [Volume(pct: 95), Mute(on: false)]
  ex on_key(playing(), "M", 0, 0, 0).cmds == [Mute(on: true)]
  ex on_key(playing(), "]", 0, 0, 0).cmds == [Rate(pct: 125)]
  ex on_key(playing(), "[", 0, 0, 0).cmds == [Rate(pct: 75)]
  ex on_key(set_rate(playing(), 200, 0).p, "BACKSPACE", 0, 0, 0).cmds == [Rate(pct: 100)]
  ex on_key(playing(), "F", 0, 0, 0).cmds == [Full(on: true)]
  ex on_key(playing(), "ENTER", 0, 0, 0).cmds == [Full(on: true)]
  ex on_key(set_full(playing(), true).p, "ESC", 0, 0, 0).cmds == [Full(on: false)]
  ex on_key(playing(), "ESC", 0, 0, 0).cmds == []
  ex on_key(playing(), "N", 0, 0, 0).p.idx == 1
  ex on_key(playing(), "PGDN", 0, 0, 0).p.idx == 1
  ex on_key(go(playing(), 1, 0).p, "P", 0, 0, 0).p.idx == 0
  ex on_key(go(playing(), 1, 0).p, "PGUP", 0, 0, 0).p.idx == 0
  ex on_key(playing(), "O", 0, 0, 0).cmds == [Pick]
  ex on_key(playing(), "Q", 0, 0, 0).p.quit == true
  ex on_key(playing(), "F1", 0, 0, 7).p.note == help
  ex on_key(playing(), "ctrl+Z", 0, 0, 0).cmds == []
{
  let none_cmds: List[Cmd] = []
  if key == "SPACE" {
    return toggle_pause(p)
  }
  if key == "RIGHT" or key == "LEFT" or key == "shift+RIGHT" or key == "shift+LEFT" {
    var step = seek_small
    if starts_with(key, "shift+") {
      step = seek_big
    }
    if ends_with(key, "LEFT") {
      step = -step
    }
    return seek_by(p, step, pos, dur)
  }
  if key == "HOME" {
    return seek_by(p, -pos, pos, dur)
  }
  if len(key) == 1 and byte(key, 0) >= 48 and byte(key, 0) <= 57 {
    let tenth = byte(key, 0) - 48
    return seek_by(p, dur / 10 * tenth - pos, pos, dur)
  }
  if key == "UP" {
    return set_volume(p, p.vol + vol_step, now)
  }
  if key == "DOWN" {
    return set_volume(p, p.vol - vol_step, now)
  }
  if key == "M" {
    var q = p
    q.muted = not p.muted
    var msg = "Звук включён"
    if q.muted {
      msg = "Звук выключен"
    }
    return Step(p: with_note(q, msg, now), cmds: [Mute(on: q.muted)])
  }
  if key == "]" {
    return set_rate(p, p.rate + 25, now)
  }
  if key == "[" {
    return set_rate(p, p.rate - 25, now)
  }
  if key == "BACKSPACE" {
    return set_rate(p, 100, now)
  }
  if key == "F" or key == "ENTER" {
    return set_full(p, not p.full)
  }
  if key == "ESC" {
    if p.full {
      return set_full(p, false)
    }
    return Step(p: p, cmds: none_cmds)
  }
  if key == "N" or key == "PGDN" {
    return go(p, 1, now)
  }
  if key == "P" or key == "PGUP" {
    return go(p, -1, now)
  }
  if key == "O" {
    return Step(p: p, cmds: [Pick])
  }
  if key == "Q" {
    var q = p
    q.quit = true
    return Step(p: q, cmds: none_cmds)
  }
  if key == "F1" {
    var q = with_note(p, help, now)
    q.note_until = now + 3 * note_ms
    return Step(p: q, cmds: none_cmds)
  }
  return Step(p: p, cmds: none_cmds)
}

fn on_event(p: Player, ev: Ev, pos: Int, dur: Int, now: Int) -> Step
  ex on_event(playing(), Tick, 0, 0, 0).cmds == []
  ex on_event(playing(), Key(name: "SPACE"), 0, 0, 0).cmds == [Pause(on: true)]
  ex on_event(playing(), Click, 0, 0, 0).cmds == [Pause(on: true)]
  ex on_event(playing(), DblClick, 0, 0, 0).cmds == [Full(on: true)]
  ex on_event(playing(), Wheel(up: false), 0, 0, 0).cmds == [Volume(pct: 95), Mute(on: false)]
  ex on_event(playing(), Wheel(up: true), 0, 0, 0).p.vol == 100
  ex on_event(playing(), Drop(paths: ["D:\\new.mp4"]), 0, 0, 0).cmds == [Open(path: "D:\\new.mp4"), Title(text: "new.mp4 — Dovod Player")]
  ex on_event(playing(), Drop(paths: ["D:\\new.mp4"]), 0, 0, 0).p.files == ["D:\\new.mp4"]
  ex on_event(toggle_pause(playing()).p, Loaded, 0, 0, 0).p.paused == false
  ex on_event(playing(), Ended, 0, 0, 0).p.idx == 1
  ex on_event(go(playing(), 1, 0).p, Ended, 0, 0, 0).p.ended == true
  ex on_event(playing(), Closed, 0, 0, 0).p.quit == true
  ex on_event(playing(), Failed(msg: "no decoder"), 0, 0, 0).p.note == "Ошибка: no decoder"
{
  let none_cmds: List[Cmd] = []
  match ev {
    Tick => { return Step(p: p, cmds: none_cmds) }
    Key(name) => { return on_key(p, name, pos, dur, now) }
    Click => { return toggle_pause(p) }
    DblClick => { return set_full(p, not p.full) }
    Wheel(up) => {
      if up {
        return set_volume(p, p.vol + vol_step, now)
      }
      return set_volume(p, p.vol - vol_step, now)
    }
    Drop(paths) => { return open_at(new_player_like(p, paths), 0) }
    Loaded => {
      var q = p
      q.paused = false
      q.ended = false
      return Step(p: q, cmds: none_cmds)
    }
    Ended => {
      if p.idx + 1 < len(p.files) {
        return open_at(p, p.idx + 1)
      }
      var q = with_note(p, "Конец. Пробел — сначала", now)
      q.ended = true
      q.paused = true
      q.note_until = now + 1000 * 3600
      return Step(p: q, cmds: none_cmds)
    }
    Closed => {
      var q = p
      q.quit = true
      return Step(p: q, cmds: none_cmds)
    }
    Failed(msg) => {
      var q = with_note(p, "Ошибка: " + msg, now)
      q.note_until = now + 3 * note_ms
      return Step(p: q, cmds: none_cmds)
    }
  }
}

// a new playlist, keeping the listener's settings (volume, speed, full screen)
fn new_player_like(p: Player, files: List[Text]) -> Player
  need len(files) > 0
  ex new_player_like(set_volume(playing(), 30, 0).p, ["z.mp4"]).vol == 30
  ex new_player_like(playing(), ["z.mp4"]).files == ["z.mp4"]
{
  var q = p
  q.files = files
  q.idx = -1
  return q
}

fn status(p: Player, pos: Int, dur: Int, now: Int) -> Text
  ex status(new_player([]), 0, 0, 0) == "Перетащите видео в окно или нажмите O · F1 — клавиши"
  ex status(with_note(new_player([]), "Ошибка: x", 0), 0, 0, 1) == "Ошибка: x   ·   Перетащите видео в окно или нажмите O · F1 — клавиши"
  ex status(playing(), 65000, 600000, 0) == "Играет   1:05 / 10:00   Громкость 100%   Файл 1/2"
  ex status(playing(), 22000, 20000, 0) == "Играет   0:20 / 0:20   Громкость 100%   Файл 1/2"
  ex status(set_rate(toggle_pause(playing()).p, 150, 0).p, 0, 0, 9000) == "Пауза   0:00   Громкость 100%   ×1.5   Файл 1/2"
  ex status(on_key(playing(), "M", 0, 0, 0).p, 0, 0, 10) == "Играет   0:00   Без звука   Файл 1/2   ·   Звук выключен"
{
  if p.idx < 0 {
    var hint = "Перетащите видео в окно или нажмите O · F1 — клавиши"
    if now < p.note_until {
      hint = p.note + "   ·   " + hint
    }
    return hint
  }
  var s = "Играет"
  if p.paused {
    s = "Пауза"
  }
  if dur > 0 {
    s = s + "   " + fmt_time(min(pos, dur)) + " / " + fmt_time(dur)   // a decoder may report a little past the end
  } else {
    s = s + "   " + fmt_time(pos)
  }
  if p.muted {
    s = s + "   Без звука"
  } else {
    s = s + "   Громкость " + show(p.vol) + "%"
  }
  if p.rate != 100 {
    s = s + "   ×" + rate_text(p.rate)
  }
  s = s + "   Файл " + show(p.idx + 1) + "/" + show(len(p.files))
  if now < p.note_until {
    s = s + "   ·   " + p.note
  }
  return s
}

// ---------------------------------------------------------------- the shell

// carry out commands; `Pick` asks the user for a file and comes back as a drop event ("" = nothing)
fn apply(cmds: List[Cmd]) -> Text uses video {
  var back = ""
  for c in cmds {
    match c {
      Open(path) => {
        let _ok = video_open(path)   // a failure arrives as an "error:" event
      }
      Title(text) => { video_title(text) }
      Pick => {
        match video_pick() {
          some(path) => { back = "drop:" + path }
          none => { }
        }
      }
      Pause(on) => { video_pause(on) }
      Seek(ms) => { video_seek(ms) }
      Volume(pct) => { video_volume(pct) }
      Mute(on) => { video_mute(on) }
      Rate(pct) => { video_rate(pct) }
      Full(on) => { video_fullscreen(on) }
    }
  }
  return back
}

fn main() uses env, clock, video {
  video_title("Dovod Player")
  let first = start(new_player(args()))
  var p = first.p
  var pending = apply(first.cmds)
  while not p.quit {
    var ev = pending
    if ev == "" {
      ev = video_event()
    }
    let s = on_event(p, parse_event(ev), video_pos(), video_len(), now_ms())
    p = s.p
    pending = apply(s.cmds)
    video_status(status(p, video_pos(), video_len(), now_ms()))
  }
}

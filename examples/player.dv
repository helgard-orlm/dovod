// Dovod Player — a video player for Windows.
// Build:  dovod build examples/player.dv --target win64     (or win32 for 32-bit Windows)
// Use:    player.exe [FILES...]   or drag files into the window, or press O.
//
// Playback itself is done by Windows (Media Foundation) through the `video` effect.
// The CONTROL PANEL is a web page served by the program itself through the `ui` effect
// (opens as a browser app window; MPC-style dark theme).  Everything the player DECIDES —
// keys, clicks, the panel, the playlist, seeking, volume, the status line — is pure,
// exampled code below; `main` only carries events in and commands out.

use video
use ui

record Player {
  files: List[Text]
  idx: Int          // which file is open; -1 = none
  paused: Bool
  ended: Bool       // the current file played to its end
  vol: Int          // 0..100
  muted: Bool
  full: Bool
  rate: Int         // speed in percent, 25..400
  note: Text        // a message in the status line…
  note_until: Int   // …shown until this clock time (ms)
  seek: Int         // a seek asked for by the panel but not sent yet; -1 = none
  seek_at: Int      // when the panel last moved the seek slider (ms)
  quit: Bool
}

enum Cmd {
  Open(path: Text)
  Title(text: Text)
  Pick
  Pause(on: Bool)
  Seek(ms: Int)
  Volume(pct: Int)
  Mute(on: Bool)
  Rate(pct: Int)
  Full(on: Bool)
}

record Step { p: Player, cmds: List[Cmd] }

const seek_small: Int = 5000
const seek_big: Int = 60000
const vol_step: Int = 5
const note_ms: Int = 4000
const seek_wait: Int = 400        // the panel's seek is sent this long after the slider goes quiet
const help: Text = "Пробел пауза · ←→ 5 с, Shift 1 мин · 0–9 доля · ↑↓ громкость · M звук · [ ] скорость · F экран · N/P файлы · O открыть · Q выход"

// The panel's dark theme.  `ui` draws the page from one fixed stylesheet; a program overrides
// it with a UiHtml <style> node — looks are outside the evidence, decisions are not.
const theme: Text = "<style>\n:root{--bg:#101214;--fg:#e6e8ea;--mut:#8b9299;--card:#191d22;--line:#2b3137;--acc:#4f8cff;--accfg:#fff}\nbody{margin:0;background:var(--bg);color:var(--fg);font:14px/1.35 system-ui,'Segoe UI',Roboto,sans-serif}\n#app{max-width:1100px;margin:0 auto;padding:10px 12px}\n.col{gap:8px}\n.row{gap:8px}\nh2{font-size:16px}\np{margin:0;font-size:13px;color:var(--mut);white-space:pre-wrap}\nbutton{font:inherit;font-size:15px;padding:5px 13px;border-radius:6px;border:1px solid var(--line);background:var(--card);color:var(--fg);cursor:pointer}\nbutton:hover{border-color:var(--acc)}\nbutton:active{background:var(--acc);color:var(--accfg)}\ninput[type=text],select{font:inherit;padding:5px 9px;border-radius:6px;border:1px solid var(--line);background:var(--card);color:var(--fg);min-width:60px}\ninput:focus,select:focus,button:focus-visible{outline:2px solid var(--acc);outline-offset:1px}\nlabel{display:inline-flex;gap:6px;align-items:center}\nfieldset{border:1px solid var(--line);border-radius:8px;background:var(--card);padding:8px 10px;margin:0;min-width:0}\nlegend{padding:0 6px;color:var(--mut);font-size:12px}\ntable{border-collapse:collapse;width:100%}\nth,td{text-align:left;padding:4px 10px;border-bottom:1px solid var(--line)}\nth{color:var(--mut);font-weight:600;font-size:12px}\ntable button{width:100%;text-align:left;background:transparent;border-color:transparent;color:var(--fg);padding:4px 10px;font-weight:400}\ntable button:hover{border-color:var(--acc)}\nprogress{width:100%;height:14px;accent-color:var(--acc)}\ninput[type=range]{flex:1;min-width:160px;accent-color:var(--acc)}\n.sv{display:none}\n#off{background:#b42318}\n</style>"

// ---------------------------------------------------------------- small pieces

fn clamp(x: Int, lo: Int, hi: Int) -> Int
  need lo <= hi
  give out >= lo and out <= hi
  ex clamp(5, 0, 10) == 5
  ex clamp(-3, 0, 10) == 0
  ex clamp(42, 0, 10) == 10
{
  return max(lo, min(hi, x))
}

fn pad2(n: Int) -> Text
  need n >= 0
  ex pad2(7) == "07"
  ex pad2(9) == "09"
  ex pad2(10) == "10"
  ex pad2(42) == "42"
{
  if n < 10 {
    return "0" + show(n)
  }
  return show(n)
}

fn fmt_time(ms: Int) -> Text
  ex fmt_time(0) == "0:00"
  ex fmt_time(65999) == "1:05"
  ex fmt_time(3599000) == "59:59"
  ex fmt_time(3600000) == "1:00:00"
  ex fmt_time(3723000) == "1:02:03"
  ex fmt_time(-5000) == "0:00"
{
  let s = max(ms, 0) / 1000
  let h = s / 3600
  let m = s % 3600 / 60
  if h > 0 {
    return show(h) + ":" + pad2(m) + ":" + pad2(s % 60)
  }
  return show(m) + ":" + pad2(s % 60)
}

fn rate_text(pct: Int) -> Text
  need pct > 0
  ex rate_text(100) == "1"
  ex rate_text(150) == "1.5"
  ex rate_text(125) == "1.25"
  ex rate_text(25) == "0.25"
{
  let whole = show(pct / 100)
  let frac = pct % 100
  if frac == 0 {
    return whole
  }
  if frac % 10 == 0 {
    return whole + "." + show(frac / 10)
  }
  return whole + "." + pad2(frac)
}

// the panel's speed menu: "0.5" -> 50 percent
fn rate_of(t: Text) -> Opt[Int]
  ex rate_of("1") == some(100)
  ex rate_of("0.5") == some(50)
  ex rate_of("1.25") == some(125)
  ex rate_of("0.25") == some(25)
  ex rate_of("4") == some(400)
  ex rate_of("") == none
  ex rate_of("x") == none
  ex rate_of("1.2.3") == none
  ex rate_of("1.x") == none
  ex rate_of("e.5") == none
{
  let parts = split(t, ".")
  if len(parts) == 1 {
    match parse_int(parts[0]) {
      none => { return none }
      some(w) => { return some(w * 100) }
    }
  }
  if len(parts) != 2 {
    return none
  }
  match parse_int(parts[0]) {
    none => { return none }
    some(w) => {
      match parse_int(parts[1]) {
        none => { return none }
        some(f) => {
          if len(parts[1]) == 1 {
            return some(w * 100 + f * 10)
          }
          return some(w * 100 + f)
        }
      }
    }
  }
}

fn rate_options() -> List[Text]
  ex rate_options() == ["0.25", "0.5", "0.75", "1", "1.25", "1.5", "2", "3", "4"]
{
  return ["0.25", "0.5", "0.75", "1", "1.25", "1.5", "2", "3", "4"]
}

fn base_name(path: Text) -> Text
  ex base_name("C:\\Video\\кино.mp4") == "кино.mp4"
  ex base_name("/home/a/b.mkv") == "b.mkv"
  ex base_name("clip.avi") == "clip.avi"
  ex base_name("/x") == "x"
{
  var from = 0
  for i in 0..len(path) {
    let b = byte(path, i)
    if b == '\\' or b == '/' {
      from = i + 1
    }
  }
  return slice(path, from, len(path))
}

// ---------------------------------------------------------------- the player

fn new_player(files: List[Text]) -> Player
  ex new_player(["a.mp4"]) == Player(files: ["a.mp4"], idx: -1, paused: false, ended: false, vol: 100, muted: false,
                                     full: false, rate: 100, note: "", note_until: 0, seek: -1, seek_at: 0, quit: false)
{
  return Player(files: files, idx: -1, paused: false, ended: false, vol: 100, muted: false, full: false,
                rate: 100, note: "", note_until: 0, seek: -1, seek_at: 0, quit: false)
}

// test fixture: a player with two files, the first one playing
fn playing() -> Player
  ex playing().idx == 0
  ex len(playing().files) == 2
{
  return new_player(["C:\\v\\one.mp4", "C:\\v\\two.mkv"]) with { idx: 0 }
}

fn with_note(p: Player, text: Text, now: Int) -> Player
  ex with_note(playing(), "hi", now: 1000) == playing() with { note: "hi", note_until: 5000 }
{
  return p with { note: text, note_until: now + note_ms }
}

fn open_at(p: Player, i: Int) -> Step
  need i >= 0 and i < len(p.files)
  ex open_at(playing(), 1).cmds == [Open(path: "C:\\v\\two.mkv"), Title(text: "two.mkv — Dovod Player")]
  ex open_at(playing(), 1).p == playing() with { idx: 1 }
  ex open_at(playing() with { paused: true, ended: true }, 1).p == playing() with { idx: 1 }
{
  return Step(p: p with { idx: i, paused: false, ended: false },
              cmds: [Open(path: p.files[i]), Title(text: base_name(p.files[i]) + " — Dovod Player")])
}

fn start(p: Player) -> Step
  ex start(new_player(["x.mp4"])).cmds == [Open(path: "x.mp4"), Title(text: "x.mp4 — Dovod Player")]
  ex start(new_player([])).cmds == [Pick]
{
  if len(p.files) == 0 {
    return Step(p: p, cmds: [Pick])
  }
  return open_at(p, 0)
}

fn seek_by(p: Player, delta: Int, pos: Int, dur: Int) -> Step
  ex seek_by(playing(), delta: 5000, pos: 10000, dur: 60000).cmds == [Seek(ms: 15000)]
  ex seek_by(playing(), delta: -5000, pos: 3000, dur: 60000).cmds == [Seek(ms: 0)]
  ex seek_by(playing(), delta: 60000, pos: 30000, dur: 60000).cmds == [Seek(ms: 59000)]
  ex seek_by(playing(), delta: 5000, pos: 1000, dur: 0).cmds == [Seek(ms: 6000)]
  ex seek_by(playing(), delta: 5000, pos: 100, dur: 500).cmds == [Seek(ms: 0)]
  ex seek_by(playing(), delta: 5000, pos: 100, dur: 1).cmds == [Seek(ms: 0)]
  ex seek_by(playing() with { ended: true }, delta: -5000, pos: 9000, dur: 9000).p == playing()
{
  var target = max(pos + delta, 0)
  if dur > 0 {
    target = min(target, max(dur - 1000, 0))
  }
  return Step(p: p with { ended: false }, cmds: [Seek(ms: target)])
}

// the panel's seek: wait for the slider to go quiet, then send it once
fn pump_seek(p: Player, dur: Int, now: Int) -> Step
  ex pump_seek(playing(), 600000, 0).cmds == []
  ex pump_seek(playing() with { seek: 30000, seek_at: 1000 }, 600000, 1399).cmds == []
  ex pump_seek(playing() with { seek: 30000, seek_at: 1000 }, 600000, 1400).cmds == [Seek(ms: 30000)]
  ex pump_seek(playing() with { seek: 30000, seek_at: 1000 }, 600000, 1400).p.seek == -1
  ex pump_seek(playing() with { seek: 700000, seek_at: 0 }, 600000, 500).cmds == [Seek(ms: 599000)]
  ex pump_seek(playing() with { seek: 7000, seek_at: 0 }, 0, 500).cmds == [Seek(ms: 7000)]
  ex pump_seek(playing() with { seek: 7000, seek_at: 0 }, 1, 500).cmds == [Seek(ms: 0)]
  ex pump_seek(playing() with { seek: 0, seek_at: 0 }, 600000, 500).cmds == [Seek(ms: 0)]
  ex pump_seek(playing() with { seek: 30000, seek_at: 0, ended: true }, 600000, 500).p == playing()
{
  if p.seek < 0 {
    return Step(p: p, cmds: [])
  }
  if now - p.seek_at < seek_wait {
    return Step(p: p, cmds: [])
  }
  var target = p.seek
  if dur > 0 {
    target = min(target, max(dur - 1000, 0))
  }
  return Step(p: p with { seek: -1, ended: false }, cmds: [Seek(ms: target)])
}

fn set_volume(p: Player, vol: Int, now: Int) -> Step
  ex set_volume(playing(), 120, now: 0).cmds == [Volume(pct: 100), Mute(on: false)]
  ex set_volume(playing(), -7, now: 0).cmds == [Volume(pct: 0), Mute(on: false)]
  ex set_volume(playing() with { muted: true }, 40, now: 1000).p ==
     playing() with { vol: 40, note: "Громкость 40%", note_until: 5000 }
{
  let v = clamp(vol, 0, 100)
  return Step(p: with_note(p, "Громкость " + show(v) + "%", now) with { vol: v, muted: false },
              cmds: [Volume(pct: v), Mute(on: false)])
}

fn set_rate(p: Player, rate: Int, now: Int) -> Step
  ex set_rate(playing(), 125, now: 0).cmds == [Rate(pct: 125)]
  ex set_rate(playing(), 500, now: 0).p.rate == 400
  ex set_rate(playing(), 10, now: 0).p.note == "Скорость ×0.25"
{
  let r = clamp(rate, 25, 400)
  return Step(p: with_note(p, "Скорость ×" + rate_text(r), now) with { rate: r }, cmds: [Rate(pct: r)])
}

fn toggle_pause(p: Player) -> Step
  ex toggle_pause(playing()) == Step(p: playing() with { paused: true }, cmds: [Pause(on: true)])
  ex toggle_pause(playing() with { paused: true }) == Step(p: playing(), cmds: [Pause(on: false)])
  ex toggle_pause(new_player([])).cmds == []
  ex toggle_pause(playing() with { ended: true, paused: true, note: "Конец", note_until: 99 }) ==
     Step(p: playing() with { note: "Конец" }, cmds: [Seek(ms: 0), Pause(on: false)])   // the "end" note goes away
{
  if p.idx < 0 {
    return Step(p: p, cmds: [])
  }
  if p.ended {
    return Step(p: p with { ended: false, paused: false, note_until: 0 }, cmds: [Seek(ms: 0), Pause(on: false)])
  }
  return Step(p: p with { paused: not p.paused }, cmds: [Pause(on: not p.paused)])
}

fn set_full(p: Player, on: Bool) -> Step
  ex set_full(playing(), true) == Step(p: playing() with { full: true }, cmds: [Full(on: true)])
{
  return Step(p: p with { full: on }, cmds: [Full(on: on)])
}

fn toggle_mute(p: Player, now: Int) -> Step
  ex toggle_mute(playing(), 0).cmds == [Mute(on: true)]
  ex toggle_mute(playing(), 0).p.muted == true
  ex toggle_mute(playing() with { muted: true }, 5).cmds == [Mute(on: false)]
  ex toggle_mute(playing() with { muted: true }, 5).p.note == "Звук включён"
{
  var msg = "Звук включён"
  if not p.muted {
    msg = "Звук выключен"
  }
  return Step(p: with_note(p, msg, now) with { muted: not p.muted }, cmds: [Mute(on: not p.muted)])
}

fn go(p: Player, delta: Int, now: Int) -> Step
  ex go(playing(), 1, now: 0).p.idx == 1
  ex go(playing(), -1, now: 0).p.note == "Это первый файл"
  ex go(go(playing(), 1, now: 0).p, 1, now: 0).p.note == "Это последний файл"
  ex go(new_player([]), 1, now: 0).cmds == []
{
  if p.idx < 0 {
    return Step(p: p, cmds: [])
  }
  let i = p.idx + delta
  if i < 0 {
    return Step(p: with_note(p, "Это первый файл", now), cmds: [])
  }
  if i >= len(p.files) {
    return Step(p: with_note(p, "Это последний файл", now), cmds: [])
  }
  return open_at(p, i)
}

fn on_key(p: Player, key: Text, pos: Int, dur: Int, now: Int) -> Step
  ex on_key(playing(), "SPACE", 0, 0, 0).cmds == [Pause(on: true)]
  ex on_key(playing(), "RIGHT", 10000, 60000, 0).cmds == [Seek(ms: 15000)]
  ex on_key(playing(), "LEFT", 10000, 60000, 0).cmds == [Seek(ms: 5000)]
  ex on_key(playing(), "shift+RIGHT", 0, 600000, 0).cmds == [Seek(ms: 60000)]
  ex on_key(playing(), "shift+LEFT", 90000, 600000, 0).cmds == [Seek(ms: 30000)]
  ex on_key(playing(), "HOME", 90000, 600000, 0).cmds == [Seek(ms: 0)]
  ex on_key(playing(), "5", 0, 600000, 0).cmds == [Seek(ms: 300000)]
  ex on_key(playing(), "0", 7000, 600000, 0).cmds == [Seek(ms: 0)]
  ex on_key(playing(), "9", 7000, 600000, 0).cmds == [Seek(ms: 540000)]
  ex on_key(playing(), "/", 7000, 600000, 0).cmds == []
  ex on_key(playing(), ":", 7000, 600000, 0).cmds == []
  ex on_key(playing(), "55", 7000, 600000, 0).cmds == []
  ex on_key(playing(), "UP", 0, 0, 0).cmds == [Volume(pct: 100), Mute(on: false)]
  ex on_key(playing(), "DOWN", 0, 0, 0).cmds == [Volume(pct: 95), Mute(on: false)]
  ex on_key(playing(), "M", 0, 0, 0).cmds == [Mute(on: true)]
  ex on_key(playing(), "]", 0, 0, 0).cmds == [Rate(pct: 125)]
  ex on_key(playing(), "[", 0, 0, 0).cmds == [Rate(pct: 75)]
  ex on_key(set_rate(playing(), 200, now: 0).p, "BACKSPACE", 0, 0, 0).cmds == [Rate(pct: 100)]
  ex on_key(playing(), "F", 0, 0, 0).cmds == [Full(on: true)]
  ex on_key(playing(), "ENTER", 0, 0, 0).cmds == [Full(on: true)]
  ex on_key(set_full(playing(), true).p, "ESC", 0, 0, 0).cmds == [Full(on: false)]
  ex on_key(playing(), "ESC", 0, 0, 0).cmds == []
  ex on_key(playing(), "N", 0, 0, 0).p.idx == 1
  ex on_key(playing(), "PGDN", 0, 0, 0).p.idx == 1
  ex on_key(go(playing(), 1, now: 0).p, "P", 0, 0, 0).p.idx == 0
  ex on_key(go(playing(), 1, now: 0).p, "PGUP", 0, 0, 0).p.idx == 0
  ex on_key(playing(), "O", 0, 0, 0).cmds == [Pick]
  ex on_key(playing(), "Q", 0, 0, 0).p.quit == true
  ex on_key(playing(), "F1", 0, 0, 7).p == playing() with { note: help, note_until: 12007 }
  ex on_key(playing(), "M", 0, 0, 0).p.muted == true
  ex on_key(playing() with { muted: true }, "M", 0, 0, 0).p.note == "Звук включён"
  ex on_key(playing(), "ctrl+Z", 0, 0, 0).cmds == []{
  match key {
    "SPACE" => { return toggle_pause(p) }
    "RIGHT" => { return seek_by(p, delta: seek_small, pos: pos, dur: dur) }
    "LEFT" => { return seek_by(p, delta: -seek_small, pos: pos, dur: dur) }
    "shift+RIGHT" => { return seek_by(p, delta: seek_big, pos: pos, dur: dur) }
    "shift+LEFT" => { return seek_by(p, delta: -seek_big, pos: pos, dur: dur) }
    "HOME" => { return seek_by(p, delta: -pos, pos: pos, dur: dur) }
    "UP" => { return set_volume(p, p.vol + vol_step, now) }
    "DOWN" => { return set_volume(p, p.vol - vol_step, now) }
    "M" => { return toggle_mute(p, now) }
    "]" => { return set_rate(p, p.rate + 25, now) }
    "[" => { return set_rate(p, p.rate - 25, now) }
    "BACKSPACE" => { return set_rate(p, 100, now) }
    "F", "ENTER" => { return set_full(p, not p.full) }
    "ESC" => {
      if p.full {
        return set_full(p, false)
      }
      return Step(p: p, cmds: [])
    }
    "N", "PGDN" => { return go(p, 1, now) }
    "P", "PGUP" => { return go(p, -1, now) }
    "O" => { return Step(p: p, cmds: [Pick]) }
    "Q" => { return Step(p: p with { quit: true }, cmds: []) }
    "F1" => { return Step(p: p with { note: help, note_until: now + 3 * note_ms }, cmds: []) }
    else => {
      if len(key) == 1 and byte(key, 0) >= '0' and byte(key, 0) <= '9' {   // 0–9: jump to that tenth
        return seek_by(p, delta: dur / 10 * (byte(key, 0) - '0') - pos, pos: pos, dur: dur)
      }
      return Step(p: p, cmds: [])
    }
  }
}

fn on_event(p: Player, ev: VideoEv, pos: Int, dur: Int, now: Int) -> Step
  ex on_event(playing(), VideoTick, 0, 0, 0).cmds == []
  ex on_event(playing(), VideoKey(name: "SPACE"), 0, 0, 0).cmds == [Pause(on: true)]
  ex on_event(playing(), VideoClick, 0, 0, 0).cmds == [Pause(on: true)]
  ex on_event(playing(), VideoDblClick, 0, 0, 0).cmds == [Full(on: true)]
  ex on_event(playing(), VideoWheel(up: false), 0, 0, 0).cmds == [Volume(pct: 95), Mute(on: false)]
  ex on_event(playing(), VideoWheel(up: true), 0, 0, 0).p.vol == 100
  ex on_event(playing(), VideoDrop(paths: ["D:\\new.mp4"]), 0, 0, 0).cmds == [Open(path: "D:\\new.mp4"), Title(text: "new.mp4 — Dovod Player")]
  ex on_event(playing(), VideoDrop(paths: ["D:\\new.mp4"]), 0, 0, 0).p.files == ["D:\\new.mp4"]
  ex on_event(playing() with { paused: true, ended: true }, VideoLoaded, 0, 0, 0).p == playing()
  ex on_event(playing(), VideoEnded, 0, 0, 0).p.idx == 1
  ex on_event(playing(), VideoNoAudio, 0, 0, 5).p ==
     playing() with { note: "Windows не выбрала аудиопоток — кодек не декодируется?", note_until: 4005 }
  ex on_event(playing() with { idx: 1 }, VideoEnded, 0, 0, 5).p ==
     playing() with { idx: 1, ended: true, paused: true, note: "Конец. Пробел — сначала", note_until: 3600005 }
  ex on_event(playing(), VideoClosed, 0, 0, 0).p.quit == true
  ex on_event(playing(), VideoFailed(msg: "no decoder"), 0, 0, 5).p == playing() with { note: "Ошибка: no decoder", note_until: 12005 }{
  match ev {
    VideoTick => { return Step(p: p, cmds: []) }
    VideoKey(name) => { return on_key(p, name, pos, dur, now) }
    VideoClick => { return toggle_pause(p) }
    VideoDblClick => { return set_full(p, not p.full) }
    VideoWheel(up) => {
      if up {
        return set_volume(p, p.vol + vol_step, now)
      }
      return set_volume(p, p.vol - vol_step, now)
    }
    VideoDrop(paths) => { return open_at(new_player_like(p, paths), 0) }
    VideoLoaded => { return Step(p: p with { paused: false, ended: false }, cmds: []) }
    VideoEnded => {
      if p.idx + 1 < len(p.files) {
        return open_at(p, p.idx + 1)
      }
      return Step(p: p with { ended: true, paused: true, note: "Конец. Пробел — сначала", note_until: now + 1000 * 3600 },
                  cmds: [])
    }
    VideoNoAudio => {
      return Step(p: with_note(p, "Windows не выбрала аудиопоток — кодек не декодируется?", now), cmds: [])
    }
    VideoClosed => { return Step(p: p with { quit: true }, cmds: []) }
    VideoFailed(msg) => { return Step(p: with_note(p, "Ошибка: " + msg, now) with { note_until: now + 3 * note_ms }, cmds: []) }
  }
}

// ---------------------------------------------------------------- the panel (a pure function of the state)

fn play_label(p: Player) -> Text
  ex play_label(playing()) == "⏸"
  ex play_label(playing() with { paused: true }) == "▶"
  ex play_label(playing() with { ended: true }) == "▶"
  ex play_label(new_player([])) == "▶"
{
  if p.idx >= 0 and not p.paused and not p.ended {
    return "⏸"
  }
  return "▶"
}

fn mute_label(p: Player) -> Text
  ex mute_label(playing()) == "🔊"
  ex mute_label(playing() with { muted: true }) == "🔇"
{
  if p.muted {
    return "🔇"
  }
  return "🔊"
}

fn vol_label(p: Player) -> Text
  ex vol_label(playing()) == "100%"
  ex vol_label(playing() with { vol: 7 }) == "7%"
{
  return show(p.vol) + "%"
}

fn time_text(pos: Int, dur: Int) -> Text
  ex time_text(65000, 600000) == "1:05 / 10:00"
  ex time_text(700000, 600000) == "10:00 / 10:00"
  ex time_text(65000, 0) == "1:05"
  ex time_text(65000, 1) == "0:00 / 0:00"
  ex time_text(0, 0) == "0:00"
{
  if dur > 0 {
    return fmt_time(min(pos, dur)) + " / " + fmt_time(dur)
  }
  return fmt_time(pos)
}

fn slider_pos(pos: Int, dur: Int) -> Int
  ex slider_pos(65000, 600000) == 65000
  ex slider_pos(700000, 600000) == 600000
  ex slider_pos(-5, 600000) == 0
  ex slider_pos(5, 1) == 1
  ex slider_pos(123, 0) == 0
{
  if dur <= 0 {
    return 0
  }
  return clamp(pos, 0, dur)
}

// the one-line message under the controls: a fresh note, or a hint when nothing is open
fn panel_note(p: Player, now: Int) -> Text
  ex panel_note(playing(), 0) == ""
  ex panel_note(with_note(playing(), "Громкость 40%", now: 1000), 2000) == "Громкость 40%"
  ex panel_note(with_note(playing(), "Громкость 40%", now: 1000), 6000) == ""
  ex panel_note(new_player([]), 0) == "Перетащите видео в окно плеера или нажмите «Открыть»"
{
  if now < p.note_until {
    return p.note
  }
  if p.idx < 0 {
    return "Перетащите видео в окно плеера или нажмите «Открыть»"
  }
  return ""
}

fn file_label(p: Player, i: Int) -> Text
  need i >= 0 and i < len(p.files)
  ex file_label(playing(), 0) == "▶ one.mp4"
  ex file_label(playing(), 1) == "two.mkv"
  ex file_label(playing() with { idx: 1 }, 1) == "▶ two.mkv"
{
  var t = base_name(p.files[i])
  if i == p.idx {
    t = "▶ " + t
  }
  return t
}

fn playlist_rows(p: Player) -> List[UiNode]
  ex playlist_rows(playing()) == [UiButton(id: "file", arg: 0, label: "▶ one.mp4"),
                                  UiButton(id: "file", arg: 1, label: "two.mkv")]
  ex playlist_rows(new_player([])) == []
{
  var rows: List[UiNode] = []
  for i in 0..len(p.files) {
    rows.push(UiButton(id: "file", arg: i, label: file_label(p, i)))
  }
  return rows
}

fn playlist_box(p: Player) -> UiNode
  ex playlist_box(playing()) == UiBox(title: "Плейлист", kids: [UiTable(head: ["Файл"], rows: playlist_rows(playing()))])
  ex playlist_box(new_player([])) == UiBox(title: "Плейлист", kids: [UiText(text: "Пусто — перетащите видео в окно плеера")])
{
  var kids: List[UiNode] = [UiTable(head: ["Файл"], rows: playlist_rows(p))]
  if len(p.files) == 0 {
    kids = [UiText(text: "Пусто — перетащите видео в окно плеера")]
  }
  return UiBox(title: "Плейлист", kids: kids)
}

// the whole panel: what is on screen is a pure function of the player's state
fn view(p: Player, pos: Int, dur: Int, now: Int) -> UiNode
  ex view(playing(), 65000, 600000, 0) == UiCol(kids: [
      UiHtml(html: theme),
      UiRow(kids: [UiButton(id: "prev", arg: 0, label: "⏮"),
                   UiButton(id: "play", arg: 0, label: "⏸"),
                   UiButton(id: "next", arg: 0, label: "⏭"),
                   UiSlider(id: "seek", arg: 0, value: 65000, lo: 0, hi: 600000),
                   UiText(text: "1:05 / 10:00")]),
      UiRow(kids: [UiButton(id: "mute", arg: 0, label: "🔊"),
                   UiSlider(id: "vol", arg: 0, value: 100, lo: 0, hi: 100),
                   UiText(text: "100%"),
                   UiSelect(id: "rate", arg: 0, value: "1", options: rate_options()),
                   UiButton(id: "full", arg: 0, label: "⛶"),
                   UiButton(id: "open", arg: 0, label: "Открыть…")]),
      UiText(text: ""),
      playlist_box(playing())])
  ex view(new_player([]), 0, 0, 0) == UiCol(kids: [
      UiHtml(html: theme),
      UiRow(kids: [UiButton(id: "prev", arg: 0, label: "⏮"),
                   UiButton(id: "play", arg: 0, label: "▶"),
                   UiButton(id: "next", arg: 0, label: "⏭"),
                   UiSlider(id: "seek", arg: 0, value: 0, lo: 0, hi: 1),
                   UiText(text: "0:00")]),
      UiRow(kids: [UiButton(id: "mute", arg: 0, label: "🔊"),
                   UiSlider(id: "vol", arg: 0, value: 100, lo: 0, hi: 100),
                   UiText(text: "100%"),
                   UiSelect(id: "rate", arg: 0, value: "1", options: rate_options()),
                   UiButton(id: "full", arg: 0, label: "⛶"),
                   UiButton(id: "open", arg: 0, label: "Открыть…")]),
      UiText(text: "Перетащите видео в окно плеера или нажмите «Открыть»"),
      playlist_box(new_player([]))])
{
  return UiCol(kids: [
    UiHtml(html: theme),
    UiRow(kids: [UiButton(id: "prev", arg: 0, label: "⏮"),
                 UiButton(id: "play", arg: 0, label: play_label(p)),
                 UiButton(id: "next", arg: 0, label: "⏭"),
                 UiSlider(id: "seek", arg: 0, value: slider_pos(pos, dur), lo: 0, hi: max(dur, 1)),
                 UiText(text: time_text(pos, dur))]),
    UiRow(kids: [UiButton(id: "mute", arg: 0, label: mute_label(p)),
                 UiSlider(id: "vol", arg: 0, value: p.vol, lo: 0, hi: 100),
                 UiText(text: vol_label(p)),
                 UiSelect(id: "rate", arg: 0, value: rate_text(p.rate), options: rate_options()),
                 UiButton(id: "full", arg: 0, label: "⛶"),
                 UiButton(id: "open", arg: 0, label: "Открыть…")]),
    UiText(text: panel_note(p, now)),
    playlist_box(p)])
}

// what a panel click or a slider change does
fn on_ui(p: Player, ev: UiEv, now: Int) -> Step
  ex on_ui(playing(), UiTick, 0).cmds == []
  ex on_ui(playing(), UiOpened, 0).cmds == []
  ex on_ui(playing(), UiClosed, 0).cmds == []            // a closed panel is not the player's end
  ex on_ui(playing(), UiClick(id: "play", arg: 0), 0).cmds == [Pause(on: true)]
  ex on_ui(playing() with { paused: true }, UiClick(id: "play", arg: 0), 0).cmds == [Pause(on: false)]
  ex on_ui(playing(), UiClick(id: "prev", arg: 0), 0).p.note == "Это первый файл"
  ex on_ui(playing() with { files: ["a", "b", "c"], idx: 2 }, UiClick(id: "prev", arg: 0), 0).p.idx == 1
  ex on_ui(playing(), UiClick(id: "next", arg: 0), 0).p.idx == 1
  ex on_ui(playing(), UiClick(id: "file", arg: 1), 0).cmds == [Open(path: "C:\\v\\two.mkv"), Title(text: "two.mkv — Dovod Player")]
  ex on_ui(playing(), UiClick(id: "file", arg: 0), 0).cmds == [Open(path: "C:\\v\\one.mp4"), Title(text: "one.mp4 — Dovod Player")]
  ex on_ui(playing(), UiClick(id: "file", arg: 9), 0).cmds == []
  ex on_ui(new_player([]), UiClick(id: "file", arg: 0), 0).cmds == []
  ex on_ui(playing(), UiClick(id: "open", arg: 0), 0).cmds == [Pick]
  ex on_ui(playing(), UiClick(id: "full", arg: 0), 0).cmds == [Full(on: true)]
  ex on_ui(set_full(playing(), true).p, UiClick(id: "full", arg: 0), 0).cmds == [Full(on: false)]
  ex on_ui(playing(), UiClick(id: "mute", arg: 0), 0).cmds == [Mute(on: true)]
  ex on_ui(playing() with { muted: true }, UiClick(id: "mute", arg: 0), 0).cmds == [Mute(on: false)]
  ex on_ui(playing(), UiClick(id: "nope", arg: 0), 0).cmds == []
  ex on_ui(playing(), UiChange(id: "seek", arg: 0, value: "123456"), 1000).p ==
     playing() with { seek: 123456, seek_at: 1000 }
  ex on_ui(playing(), UiChange(id: "seek", arg: 0, value: "x"), 1000).p == playing()
  ex on_ui(playing(), UiChange(id: "vol", arg: 0, value: "73"), 1000).cmds == [Volume(pct: 73), Mute(on: false)]
  ex on_ui(playing(), UiChange(id: "vol", arg: 0, value: "x"), 1000).cmds == []
  ex on_ui(playing(), UiChange(id: "rate", arg: 0, value: "1.5"), 1000).cmds == [Rate(pct: 150)]
  ex on_ui(playing(), UiChange(id: "rate", arg: 0, value: "9"), 1000).cmds == [Rate(pct: 400)]
  ex on_ui(playing(), UiChange(id: "rate", arg: 0, value: "x"), 1000).cmds == []
  ex on_ui(playing(), UiChange(id: "other", arg: 0, value: "1"), 0).cmds == []
{
  match ev {
    UiTick => { return Step(p: p, cmds: []) }
    UiOpened => { return Step(p: p, cmds: []) }
    UiClosed => { return Step(p: p, cmds: []) }
    UiClick(id, arg) => {
      match id {
        "play" => { return toggle_pause(p) }
        "prev" => { return go(p, -1, now) }
        "next" => { return go(p, 1, now) }
        "full" => { return set_full(p, not p.full) }
        "mute" => { return toggle_mute(p, now) }
        "open" => { return Step(p: p, cmds: [Pick]) }
        "file" => {
          if arg >= 0 and arg < len(p.files) {
            return open_at(p, arg)
          }
          return Step(p: p, cmds: [])
        }
        else => { return Step(p: p, cmds: []) }
      }
    }
    UiChange(id, value) => {
      match id {
        "seek" => {
          match parse_int(value) {
            some(ms) => { return Step(p: p with { seek: ms, seek_at: now }, cmds: []) }
            none => { return Step(p: p, cmds: []) }
          }
        }
        "vol" => {
          match parse_int(value) {
            some(v) => { return set_volume(p, v, now) }
            none => { return Step(p: p, cmds: []) }
          }
        }
        "rate" => {
          match rate_of(value) {
            some(r) => { return set_rate(p, r, now) }
            none => { return Step(p: p, cmds: []) }
          }
        }
        else => { return Step(p: p, cmds: []) }
      }
    }
  }
}

// a new playlist, keeping the listener's settings (volume, speed, full screen)
fn new_player_like(p: Player, files: List[Text]) -> Player
  need len(files) > 0
  ex new_player_like(playing() with { vol: 30 }, ["z.mp4"]) == new_player(["z.mp4"]) with { vol: 30 }
{
  return p with { files: files, idx: -1 }
}

fn status(p: Player, pos: Int, dur: Int, now: Int) -> Text
  ex status(new_player([]), 0, 0, 0) == "Перетащите видео в окно или нажмите O · F1 — клавиши"
  ex status(with_note(new_player([]), "Ошибка: x", now: 0), 0, 0, 1) == "Ошибка: x   ·   Перетащите видео в окно или нажмите O · F1 — клавиши"
  ex status(playing(), 65000, 600000, 0) == "Играет   1:05 / 10:00   Громкость 100%   Файл 1/2"
  ex status(playing(), 65000, 1, 0) == "Играет   0:00 / 0:00   Громкость 100%   Файл 1/2"
  ex status(playing(), 22000, 20000, 0) == "Играет   0:20 / 0:20   Громкость 100%   Файл 1/2"
  ex status(set_rate(toggle_pause(playing()).p, 150, now: 0).p, 0, 0, 9000) == "Пауза   0:00   Громкость 100%   ×1.5   Файл 1/2"
  ex status(on_key(playing(), "M", 0, 0, 0).p, 0, 0, 10) == "Играет   0:00   Без звука   Файл 1/2   ·   Звук выключен"
{
  if p.idx < 0 {
    var hint = "Перетащите видео в окно или нажмите O · F1 — клавиши"
    if now < p.note_until {
      hint = p.note + "   ·   " + hint
    }
    return hint
  }
  var s = "Играет"
  if p.paused {
    s = "Пауза"
  }
  if dur > 0 {
    s = s + "   " + fmt_time(min(pos, dur)) + " / " + fmt_time(dur)   // a decoder may report a little past the end
  } else {
    s = s + "   " + fmt_time(pos)
  }
  if p.muted {
    s = s + "   Без звука"
  } else {
    s = s + "   Громкость " + show(p.vol) + "%"
  }
  if p.rate != 100 {
    s = s + "   ×" + rate_text(p.rate)
  }
  s = s + "   Файл " + show(p.idx + 1) + "/" + show(len(p.files))
  if now < p.note_until {
    s = s + "   ·   " + p.note
  }
  return s
}

// ---------------------------------------------------------------- the shell

// carry out commands; `Pick` asks the user for a file and comes back as a drop event ("" = nothing)
fn apply(cmds: List[Cmd]) -> Text uses video {
  var back = ""
  for c in cmds {
    match c {
      Open(path) => {
        let _ok = video_open(path)   // a failure arrives as an "error:" event
      }
      Title(text) => { video_title(text) }
      Pick => {
        match video_pick() {
          some(path) => { back = "drop:" + path }
          none => { }
        }
      }
      Pause(on) => { video_pause(on) }
      Seek(ms) => { video_seek(ms) }
      Volume(pct) => { video_volume(pct) }
      Mute(on) => { video_mute(on) }
      Rate(pct) => { video_rate(pct) }
      Full(on) => { video_fullscreen(on) }
    }
  }
  return back
}

fn main() uses io, env, clock, video, ui {
  video_title("Dovod Player")
  match ui_listen(0, false) {          // 0 = any free port; the panel is served to this machine only
    none => { trap("панель: не удалось открыть порт") }
    some(port) => {
      print("Панель: http://127.0.0.1:" + show(port) + "/")
    }
  }
  ui_window("Dovod Player — панель")
  let first = start(new_player(args()))
  var p = first.p
  var pending = apply(first.cmds)
  while not p.quit {
    var ev = video_parse(pending)
    if pending == "" {
      ev = video_next()
    }
    let pos = video_pos()
    let dur = video_len()
    let now = now_ms()
    let s = on_event(p, ev, pos, dur, now)
    p = s.p
    pending = apply(s.cmds)
    let uev = ui_next()
    if uev != UiTick {
      let su = on_ui(p, uev, now)
      p = su.p
      let back = apply(su.cmds)
      if back != "" {
        pending = back
      }
    }
    let sp = pump_seek(p, dur, now)
    p = sp.p
    let _sent = apply(sp.cmds)
    video_status(status(p, video_pos(), video_len(), now_ms()))
    ui_show(view(p, video_pos(), video_len(), now_ms()))
  }
}

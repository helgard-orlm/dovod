// Typing trainer: touch typing in English and Russian. A window program on the `ui` module.
// Run:    dovod run examples/typing.dv               (opens a browser window)
// Build:  dovod build examples/typing.dv --target win64     -> one .exe, no DLLs
//
// A run of a lesson is a few lines picked at random from the lesson's words; you type them in the field,
// the line above shows every letter green (right), red (wrong) or under the cursor. A wrong letter has to be
// erased before the line counts. Speed counts only correct characters, from the first key to the last.
// Lessons go row by row (home, top, bottom), then capitals, digits, common words, whole sentences.
// The on-screen keyboard with the next key lit is a crutch, so it is off until you switch it on.
// Best results per lesson are kept in typing_records.txt next to where the program is started.
//
// Everything that decides anything is pure (`update`, `view`); `main` only carries events and the file.
use ui

const width: Int = 44              // a line of words is at most this many characters
const lines_per_run: Int = 4
const records_file: Text = "typing_records.txt"

record Lesson {
  title: Text
  keys: Text                       // every character the lesson may use (besides the space)
  pool: List[Text]                 // words, or whole lines when `whole`
  whole: Bool
}

record Best { key: Text, cpm: Int, acc: Int }

record KeyPos { row: Int, col: Int, shift: Bool }

record Model {
  lang: Int                        // 0 English, 1 Russian
  lesson: Int
  lines: List[Text]
  line: Int                        // the line being typed (the last one once finished)
  typed: Text                      // what is in the field now
  keys: Int                        // characters added by the user, right or wrong
  errors: Int                      // characters added that did not match
  start: Int                       // ms of the first key; -1 = not started
  finish: Int                      // ms the last line was done; -1 = still typing
  run: Int                         // grows with every new run: the field gets a new key and the page focuses it
  hint: Bool
  best: List[Best]
}

// ---------------------------------------------------------------- text as characters (UTF-8)

fn is_start(b: Int) -> Bool
  ex is_start(97) == true
  ex is_start(127) == true
  ex is_start(128) == false
  ex is_start(191) == false
  ex is_start(192) == true
  ex is_start(208) == true
{
  return b < 128 or b >= 192
}

fn chars(t: Text) -> List[Text]
  ex chars("ab") == ["a", "b"]
  ex chars("жа б") == ["ж", "а", " ", "б"]
  ex chars("a€b") == ["a", "€", "b"]
  ex chars("ё") == ["ё"]
  ex chars("") == []
{
  var out: List[Text] = []
  var from = 0
  for i in 1..len(t) {
    if is_start(byte(t, i)) {
      out.push(slice(t, from, i))
      from = i
    }
  }
  if len(t) > 0 {
    out.push(slice(t, from, len(t)))
  }
  return out
}

fn clen(t: Text) -> Int
  ex clen("привет") == 6
  ex clen("hi") == 2
  ex clen("") == 0
{
  return len(chars(t))
}

fn html_esc(t: Text) -> Text
  ex html_esc("a<b>&\"c\"") == "a&lt;b&gt;&amp;&quot;c&quot;"
  ex html_esc("ж;") == "ж;"
{
  return replace(replace(replace(replace(t, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;")
}

// ---------------------------------------------------------------- lessons

fn en_lessons() -> List[Lesson]
  ex len(en_lessons()) == 8
  ex en_lessons()[0].title == "1. Основной ряд: asdf jkl;"
  ex wholes(en_lessons()) == [false, false, false, false, false, false, false, true]
{
  return [
    Lesson(title: "1. Основной ряд: asdf jkl;", keys: "asdfjkl;", whole: false,
           pool: ["fj", "jf", "dk", "kd", "sl", "ls", "a;", ";a", "fjdk", "asdf", "jkl;", "sad", "dad", "add",
                  "fall", "all", "ask", "lass", "alas", "flask", "falls", "salad", "lads", "fads", "ads", "asks", "lad"]),
    Lesson(title: "2. + g h e i", keys: "asdfghjkl;ei", whole: false,
           pool: ["he", "she", "his", "hide", "like", "life", "file", "feel", "seed", "idea", "side", "head", "sea",
                  "see", "shelf", "field", "fish", "dial", "glide", "hike", "kid", "lid", "aid", "said", "is", "if",
                  "leg", "egg", "high", "sigh", "gas", "had", "has", "half", "hall", "glad", "flag", "dash", "shall",
                  "flash", "glass"]),
    Lesson(title: "3. Верхний ряд: q w r t y u o p", keys: "asdfghjkl;eiqwrtyuop", whole: false,
           pool: ["the", "you", "type", "power", "quiet", "water", "pretty", "tower", "people", "story", "quote",
                  "world", "yellow", "happy", "photo", "quarter", "tea", "top", "why", "write", "keep", "tool", "your",
                  "their", "there", "would", "other", "out", "fruit", "guitar", "purple", "soup", "tree", "forty",
                  "pilot", "route", "quest", "sport", "truth", "yogurt"]),
    Lesson(title: "4. Нижний ряд: z x c v b n m , .", keys: "asdfghjkl;eiqwrtyuopzxcvbnm,.", whole: false,
           pool: ["zero", "box", "cave", "big", "name", "move", "can", "next", "back", "comb", "brave", "civic",
                  "mix", "lazy", "vivid", "number", "machine", "zone", "jazz", "exam", "and", "not", "many", "come",
                  "become", "in", "on", "been", "common", "modern", "navy", "minimum", "yes,", "no.", "calm,", "done."]),
    Lesson(title: "5. Заглавные и знаки", keys: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ,.!?'\"-:;", whole: false,
           pool: ["Hello,", "Yes!", "No?", "London", "Paris", "Monday", "Friday", "I", "I'm", "It's", "Don't", "OK.",
                  "Kyiv", "Berlin", "Tokyo", "Anna", "John", "Mary", "Max", "Zoe", "Quick!", "Why?", "\"Wow\"",
                  "Well-done", "Note:", "Wait;"]),
    Lesson(title: "6. Цифры", keys: "0123456789.:%", whole: false,
           pool: ["10", "25", "365", "1984", "2026", "42", "7", "100", "12:30", "50%", "3.14", "9", "800", "64",
                  "1024", "77", "0.5", "13:45", "2048", "90%", "1", "6", "8"]),
    Lesson(title: "7. Частые слова", keys: "abcdefghijklmnopqrstuvwxyz", whole: false,
           pool: split("the of and to in is you that it he was for on are as with his they at be this have from or " +
                       "one had by word but not what all were we when your can said there use an each which she do " +
                       "how their if will up other about out many then them these so some her would make like him " +
                       "into time has look two more write go see number no way could people my than first water been " +
                       "call who now find long down day did get come made may part", " ")),
    Lesson(title: "8. Предложения", keys: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ,.!?'\"-:;", whole: true,
           pool: ["The quick brown fox jumps over the lazy dog.",
                  "Pack my box with five dozen liquor jugs.",
                  "Sphinx of black quartz, judge my vow.",
                  "How vexingly quick daft zebras jump!",
                  "Keep your eyes on the screen, not on the keys.",
                  "Small steps every day make fast hands.",
                  "Accuracy first; speed will follow.",
                  "Rain on the window sounds like soft typing.",

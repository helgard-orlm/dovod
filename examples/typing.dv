                  "подъезд", "гнездо", "зерно", "кузнец", "герой", "огурец", "ложка", "порошок", "озеро", "ведро",
                  "новый", "край", "война", "дружно", "наука", "покупка"]),
    Lesson(title: "4. Нижний ряд: ячсмить бю .", keys: "фывапролджэйцукенгшщзхъячсмитьбю.", whole: false,

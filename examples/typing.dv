           pool: ["Привет,", "Да!", "Нет.", "Как?", "Почему?", "Иван", "Мария", "Ольга", "Андрей", "Наталья",
                  "Харьков", "Одесса", "Львов", "Днепр", "Сумы", "Киев", "Понедельник", "Пятница", "Ура!", "Внимание:",
                  "\"Тише\"", "Кто-то", "Что-нибудь", "Итак;", "Хорошо.", "Спасибо!"]),

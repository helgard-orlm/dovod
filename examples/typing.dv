    Lesson(title: "3. Верхний ряд: йцукен гшщзхъ", keys: "фывапролджэйцукенгшщзхъ", whole: false,
           pool: ["город", "рука", "нога", "окно", "кенгуру", "щука", "лужа", "жук", "лук", "хорошо", "зеркало",

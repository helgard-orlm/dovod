                  "1024", "77", "0,5", "13:45", "2048", "90%", "1", "6", "8"]),
    Lesson(title: "7. Частые слова", keys: "йцукенгшщзхъфывапролджэячсмитьбю", whole: false,
           pool: split("и в не на я быть он с что а по это она этот к но они мы как из у который то за свой весь год " +

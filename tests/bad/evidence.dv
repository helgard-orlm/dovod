fn sign(x: Int) -> Int
  ex sign(5) == 1
  ex sign(0) == 0
{
  if x > 0 {
    return 1
  } else if x < 0 {
    return -1
  }
  return 0
}

fn safe_div(a: Int, b: Int) -> Int
  need b != 0
  ex safe_div(6, 3) == 2
{
  return a / b
}

fn fast_inv_sqrt(x: Float) -> Float
  assume "accurate to 1e-6 for x in 0.01..100; checked by hand against a table"
{
  return 1.0 / sqrt(x)
}

fn norm(x: Float, y: Float) -> Float
  ex near(norm(3.0, 4.0), 0.2, 0.0001)
{
  return fast_inv_sqrt(x * x + y * y)
}

fn main() uses io {
  print(show(norm(3.0, 4.0)) + " " + show(sign(-2)) + show(safe_div(4, 2)))
}

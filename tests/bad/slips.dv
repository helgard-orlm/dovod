record User { name: Text, age: Int }
enum Color { Red, Green, Blue }

fn pick(c: Color) -> Int
  ex pick(Red) == 1
{
  match c {
    Red => { return 1 }
    Green => { return 2 }
  }
}

fn avg(xs: List[Int]) -> Float
  ex true
{
  var total = 0
  for x in xs {
    totl = total + x
  }
  return total / len(xs)
}


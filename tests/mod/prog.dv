use demo
use nonative

fn label_of(raw: Text) -> Text
  ex label_of("3:volt") == "volt#3"
{
  let r = demo_parse(raw)
  return r.label + "#" + show(r.id)
}

fn main() uses io, env, demo, nonative {
  let r = demo_read()
  print(show(demo_twice(21)) + " " + demo_shout("abc") + " " + show(demo_find("xyz")) + " " + show(demo_find(""))
        + " " + join(demo_words(), ",") + " " + show(demo_level(50)) + " " + show(demo_hypot(3.0, 4.0)) + " " + show(r))
  if len(args()) == 1 {
    print(show(demo_level(101)))
  }
  if len(args()) == 2 {
    print(show(nonative_poke(1)))
  }
}
